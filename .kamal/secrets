# Secrets are resolved at deploy time from files OUTSIDE the repo — never raw
# credentials here. This file is safe to commit.

# Rails master key (config/master.key is gitignored).
RAILS_MASTER_KEY=$(cat config/master.key)

# Self-hosted registry password on westeros (same registry as tanventory).
KAMAL_REGISTRY_PASSWORD=$(cat ~/.config/aktivesolutions/registry_password)

# PostgreSQL password — shared by the app and the db accessory.
AKTIVE_SOLUTIONS_DATABASE_PASSWORD=$(cat ~/.config/aktivesolutions/database_password)
POSTGRES_PASSWORD=$(cat ~/.config/aktivesolutions/database_password)

# Seed admin password (used by db:seed to create the admin user).
ADMIN_PASSWORD=$(cat ~/.config/aktivesolutions/admin_password)

# Resend SMTP API key (outbound lead notifications). Create the file with your
# Resend API key: `echo 're_xxx' > ~/.config/aktivesolutions/smtp_password`.
# Tolerant of a missing file so deploys don't break before the key is added.
SMTP_PASSWORD=$(cat ~/.config/aktivesolutions/smtp_password 2>/dev/null)
