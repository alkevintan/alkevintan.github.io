<% set_meta title: "Contact", description: content_text("contact", "meta_description") %>

<%= render "shared/page_header", eyebrow: content_block("contact", "header_eyebrow"),
      title: content_block("contact", "header_title"),
      subtitle: content_block("contact", "header_subtitle") %>

<section class="site-container py-16">
  <div class="grid gap-12 lg:grid-cols-3">
    <%# Form %>
    <div class="lg:col-span-2">
      <% if @lead.errors.any? %>
        <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
          <p class="font-semibold">Please fix the following:</p>
          <ul class="mt-2 list-disc pl-5">
            <% @lead.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @lead, url: contact_path, method: :post, class: "space-y-6" do |f| %>
        <%# Spam traps %>
        <div class="hidden" aria-hidden="true">
          <label>Website<%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %></label>
        </div>
        <%= hidden_field_tag :form_loaded_at, Time.current.to_i %>
        <%= f.hidden_field :utm_source %>
        <%= f.hidden_field :utm_medium %>
        <%= f.hidden_field :utm_campaign %>
        <%= hidden_field_tag :source_page, request.referer %>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <%= f.label :name, "Name *", class: "block text-sm font-medium text-slate-700" %>
            <%= f.text_field :name, required: true, autocomplete: "name",
                  class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 focus:border-brand-500" %>
          </div>
          <div>
            <%= f.label :email, "Email *", class: "block text-sm font-medium text-slate-700" %>
            <%= f.email_field :email, required: true, autocomplete: "email",
                  class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 focus:border-brand-500" %>
          </div>
          <div>
            <%= f.label :phone, "Phone / WhatsApp", class: "block text-sm font-medium text-slate-700" %>
            <%= f.telephone_field :phone, autocomplete: "tel",
                  class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 focus:border-brand-500" %>
          </div>
          <div>
            <%= f.label :company, "Company", class: "block text-sm font-medium text-slate-700" %>
            <%= f.text_field :company, autocomplete: "organization",
                  class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 focus:border-brand-500" %>
          </div>
          <div>
            <%= f.label :project_type, "Project type", class: "block text-sm font-medium text-slate-700" %>
            <%= f.select :project_type, lead_options("project_type"), { prompt: "Select one" },
                  class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 focus:border-brand-500" %>
          </div>
          <div>
            <%= f.label :budget_range, "Budget", class: "block text-sm font-medium text-slate-700" %>
            <%= f.select :budget_range, lead_options("budget_range"), { prompt: "Select a range" },
                  class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 focus:border-brand-500" %>
          </div>
        </div>

        <div>
          <%= f.label :timeline, "Timeline", class: "block text-sm font-medium text-slate-700" %>
          <%= f.select :timeline, lead_options("timeline"), { prompt: "When do you want to start?" },
                class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 focus:border-brand-500 sm:max-w-xs" %>
        </div>

        <div>
          <%= f.label :message, "Tell us about your project *", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_area :message, rows: 6, required: true,
                placeholder: "What are you building? What problem should it solve?",
                class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 focus:border-brand-500" %>
        </div>

        <div class="flex items-center gap-4">
          <%= f.submit "Send my request", class: "btn btn-brand cursor-pointer" %>
          <p class="text-sm text-slate-500">We reply within one business day.</p>
        </div>
      <% end %>
    </div>

    <%# Contact sidebar %>
    <aside class="space-y-6">
      <div class="card">
        <h2 class="text-lg font-semibold text-slate-900">Prefer to reach out directly?</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <span class="block text-slate-500">Email</span>
            <%= link_to SITE[:email], "mailto:#{SITE[:email]}", class: "font-medium text-brand-600" %>
          </li>
          <% if SITE[:phone].present? && !SITE[:phone].include?("000 000") %>
            <li>
              <span class="block text-slate-500">Phone</span>
              <%= link_to SITE[:phone], "tel:#{SITE[:phone_link]}", class: "font-medium text-brand-600" %>
            </li>
          <% end %>
          <li>
            <span class="block text-slate-500">Based in</span>
            <span class="font-medium text-slate-900"><%= SITE.dig(:address, :locality) %>, <%= SITE.dig(:address, :region) %></span>
          </li>
        </ul>
      </div>
      <div class="card">
        <h2 class="text-lg font-semibold text-slate-900">Serving</h2>
        <p class="mt-3 text-sm text-slate-600"><%= SITE[:service_areas].join(" · ") %></p>
      </div>
    </aside>
  </div>
</section>
