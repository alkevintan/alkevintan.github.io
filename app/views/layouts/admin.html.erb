<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title).presence || "Admin" %> · <%= SITE[:name] %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-800">
    <div class="flex min-h-screen">
      <%# Sidebar %>
      <aside class="hidden w-60 flex-none flex-col border-r border-slate-200 bg-white lg:flex">
        <div class="border-b border-slate-200 p-5">
          <%= link_to root_path, class: "text-slate-900" do %><%= render "shared/logo" %><% end %>
          <p class="mt-1 text-xs font-medium uppercase tracking-wider text-slate-400">Admin</p>
        </div>
        <nav class="flex-1 space-y-1 p-3 text-sm">
          <% admin_nav = [
               ["Dashboard", admin_root_path, "M3 12l9-9 9 9M5 10v10h14V10"],
               ["Leads", admin_leads_path, "M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1a4 4 0 100-8 4 4 0 000 8z"],
               ["Blog Posts", admin_posts_path, "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M18 3l3 3-9 9H9v-3l9-9z"],
               ["Case Studies", admin_case_studies_path, "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-14L4 7m8 4v10M4 7v10l8 4"],
               ["Testimonials", admin_testimonials_path, "M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"],
               ["Page Content", admin_content_index_path, "M4 6h16M4 12h16M4 18h10"],
               ["Menus", admin_menu_items_path, "M4 6h16M4 10h16M4 14h16M4 18h16"],
               ["Form Options", admin_lead_options_path, "M19 11H5m14-7H5m14 14H5M9 4v16"],
               ["FAQs", admin_faqs_path, "M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"],
               ["Site Settings", edit_admin_site_setting_path, "M10.3 3.3a1 1 0 011.4 0l.6.6a1 1 0 00.9.3l.8-.1a1 1 0 011.1.7l.3.8a1 1 0 00.6.6l.8.3a1 1 0 01.7 1.1l-.1.8a1 1 0 00.3.9l.6.6a1 1 0 010 1.4l-.6.6a1 1 0 00-.3.9l.1.8a1 1 0 01-.7 1.1l-.8.3a1 1 0 00-.6.6l-.3.8a1 1 0 01-1.1.7l-.8-.1a1 1 0 00-.9.3l-.6.6a1 1 0 01-1.4 0l-.6-.6a1 1 0 00-.9-.3l-.8.1a1 1 0 01-1.1-.7l-.3-.8a1 1 0 00-.6-.6l-.8-.3a1 1 0 01-.7-1.1l.1-.8a1 1 0 00-.3-.9l-.6-.6a1 1 0 010-1.4l.6-.6a1 1 0 00.3-.9l-.1-.8a1 1 0 01.7-1.1l.8-.3a1 1 0 00.6-.6l.3-.8a1 1 0 011.1-.7l.8.1a1 1 0 00.9-.3l.6-.6zM12 15a3 3 0 100-6 3 3 0 000 6z"]
             ] %>
          <% admin_nav.each do |label, path, icon| %>
            <% active = request.path == path || (path != admin_root_path && request.path.start_with?(path)) %>
            <%= link_to path, class: "flex items-center gap-3 rounded-lg px-3 py-2 font-medium #{active ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-50'}" do %>
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/></svg>
              <%= label %>
            <% end %>
          <% end %>
        </nav>
        <div class="border-t border-slate-200 p-3 text-sm">
          <%= link_to "View site &rarr;".html_safe, root_path, target: "_blank", class: "block rounded-lg px-3 py-2 text-slate-500 hover:bg-slate-50" %>
          <%= button_to "Sign out", session_path, method: :delete, class: "w-full rounded-lg px-3 py-2 text-left text-slate-500 hover:bg-slate-50" %>
        </div>
      </aside>

      <%# Main %>
      <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex items-center justify-between border-b border-slate-200 bg-white px-6 py-3">
          <h1 class="text-lg font-semibold text-slate-900"><%= content_for(:title).presence || "Dashboard" %></h1>
          <span class="text-sm text-slate-500"><%= current_user&.email_address %></span>
        </header>

        <% flash.each do |type, message| %>
          <% next if message.blank? %>
          <div class="mx-6 mt-4 rounded-lg border px-4 py-2.5 text-sm <%= type.to_s.in?(%w[alert error]) ? 'border-red-200 bg-red-50 text-red-800' : 'border-green-200 bg-green-50 text-green-800' %>">
            <%= message %>
          </div>
        <% end %>

        <main class="flex-1 p-6"><%= yield %></main>
      </div>
    </div>
  </body>
</html>
