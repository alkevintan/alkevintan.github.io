<%# Reusable inner-page header. Locals: eyebrow (optional), title, subtitle (optional). %>
<section class="border-b border-slate-200 bg-slate-50">
  <div class="site-container py-14 sm:py-16">
    <% if local_assigns[:eyebrow].present? %>
      <p class="eyebrow"><%= eyebrow %></p>
    <% end %>
    <h1 class="mt-3 text-4xl sm:text-5xl"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="mt-4 max-w-2xl text-lg text-slate-600"><%= subtitle %></p>
    <% end %>
  </div>
</section>
