<% nav_links = menu_items("header") %>
<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur"
        data-controller="nav">
  <nav class="site-container flex h-16 items-center justify-between" aria-label="Main">
    <%= link_to root_path, class: "flex-none", aria: { label: "#{SITE[:name]} home" } do %>
      <%= render "shared/logo" %>
    <% end %>

    <%# Desktop nav %>
    <div class="hidden items-center gap-8 md:flex">
      <% nav_links.each do |item| %>
        <%= link_to item.label, item.url,
              class: "text-sm font-medium text-slate-600 transition hover:text-brand-600 #{'text-brand-600' if current_page?(item.url)}" %>
      <% end %>
      <%= link_to content_block("global", "header_cta"), contact_path, class: "btn btn-brand px-5 py-2.5" %>
    </div>

    <%# Mobile toggle %>
    <button type="button"
            class="inline-flex items-center justify-center rounded-lg p-2 text-slate-700 md:hidden"
            data-action="nav#toggle" aria-expanded="false" aria-controls="mobile-menu"
            aria-label="Toggle navigation menu">
      <svg data-nav-target="openIcon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg data-nav-target="closeIcon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </nav>

  <%# Mobile menu %>
  <div id="mobile-menu" data-nav-target="menu" class="hidden border-t border-slate-200 md:hidden">
    <div class="site-container flex flex-col gap-1 py-4">
      <% nav_links.each do |item| %>
        <%= link_to item.label, item.url, data: { action: "nav#close" },
              class: "rounded-lg px-3 py-2.5 text-base font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <%= link_to content_block("global", "header_cta"), contact_path, class: "btn btn-brand mt-2", data: { action: "nav#close" } %>
    </div>
  </div>
</header>
