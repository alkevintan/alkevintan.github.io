<% content_for :title, "Case Studies" %>

<div class="mb-5 flex justify-end">
  <%= link_to "+ New case study", new_admin_case_study_path, class: "btn btn-brand" %>
</div>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
  <% if @case_studies.any? %>
    <table class="w-full text-sm">
      <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wider text-slate-400">
        <tr>
          <th class="px-5 py-3 font-medium">Title</th>
          <th class="px-5 py-3 font-medium">Client</th>
          <th class="px-5 py-3 font-medium">Published</th>
          <th class="px-5 py-3 font-medium">Featured</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @case_studies.each do |cs| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3"><%= link_to cs.title, edit_admin_case_study_path(cs), class: "font-medium text-brand-600" %></td>
            <td class="px-5 py-3 text-slate-600"><%= cs.client.presence || "—" %></td>
            <td class="px-5 py-3"><span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium <%= cs.published? ? 'bg-green-100 text-green-800' : 'bg-slate-200 text-slate-600' %>"><%= cs.published? ? "Published" : "Draft" %></span></td>
            <td class="px-5 py-3 text-slate-600"><%= cs.featured? ? "★" : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-5 py-12 text-center text-slate-500">No case studies yet. <%= link_to "Add one", new_admin_case_study_path, class: "font-medium text-brand-600" %>.</p>
  <% end %>
</div>
