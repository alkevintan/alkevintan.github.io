<%= form_with model: [:admin, case_study], class: "space-y-6" do |f| %>
  <% if case_study.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <ul class="list-disc pl-5"><% case_study.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2 space-y-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 space-y-5">
        <div>
          <%= f.label :title, class: admin_label_class %>
          <%= f.text_field :title, class: admin_input_class %>
        </div>
        <div>
          <%= f.label :summary, "Summary (one or two sentences)", class: admin_label_class %>
          <%= f.text_area :summary, rows: 2, class: admin_input_class %>
        </div>
        <div>
          <%= f.label :body, "Full write-up", class: admin_label_class %>
          <div class="mt-1.5 rounded-lg border border-slate-300 bg-white"><%= f.rich_text_area :body %></div>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 space-y-5">
        <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
          <%= f.check_box :published, class: "rounded border-slate-300" %> Published
        </label>
        <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
          <%= f.check_box :featured, class: "rounded border-slate-300" %> Featured on home page
        </label>
        <div>
          <%= f.label :position, "Sort position", class: admin_label_class %>
          <%= f.number_field :position, class: admin_input_class %>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 space-y-5">
        <% %i[client industry tech_stack results url].each do |field| %>
          <div>
            <%= f.label field, (field == :tech_stack ? "Tech stack (comma-separated)" : field.to_s.humanize), class: admin_label_class %>
            <%= f.text_field field, class: admin_input_class %>
          </div>
        <% end %>
        <div>
          <%= f.label :meta_description, class: admin_label_class %>
          <%= f.text_area :meta_description, rows: 2, class: admin_input_class %>
        </div>
        <div>
          <%= f.label :slug, "Slug (auto if blank)", class: admin_label_class %>
          <%= f.text_field :slug, class: admin_input_class %>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6 space-y-4">
        <%= f.label :cover_image, "Cover image", class: admin_label_class %>
        <% if case_study.cover_image.attached? %>
          <%= image_tag case_study.cover_image.variant(resize_to_limit: [400, 225]), class: "rounded-lg" %>
        <% end %>
        <%= f.file_field :cover_image, accept: "image/*", class: "block w-full text-sm text-slate-600" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit(case_study.persisted? ? "Update" : "Create", class: "btn btn-brand cursor-pointer") %>
    <%= link_to "Cancel", admin_case_studies_path, class: "text-sm text-slate-500" %>
    <% if case_study.persisted? %>
      <%= button_to "Delete", admin_case_study_path(case_study), method: :delete,
            form: { data: { turbo_confirm: "Delete this case study?" }, class: "ml-auto" },
            class: "text-sm font-medium text-red-600 hover:underline" %>
    <% end %>
  </div>
<% end %>
