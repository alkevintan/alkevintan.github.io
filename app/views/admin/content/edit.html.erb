<% content_for :title, "#{@config[:label]} content" %>

<div class="mb-5 flex items-center justify-between">
  <%= link_to "&larr; All pages".html_safe, admin_content_index_path, class: "text-sm text-slate-500" %>
  <% unless @page == "global" %>
    <%= link_to "View page", "/#{@page == 'home' ? '' : @page.tr('_', '-')}", target: "_blank", class: "text-sm text-slate-500" %>
  <% end %>
</div>

<%= form_with url: admin_content_path(@page), method: :patch, class: "space-y-6" do %>
  <%# Singular copy fields %>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 space-y-5">
    <h3 class="text-sm font-semibold text-slate-900">Text</h3>
    <% @config[:blocks].each do |block| %>
      <div>
        <label class="<%= admin_label_class %>" for="block_<%= block[:key] %>"><%= block[:label] %></label>
        <% if block[:type] == :textarea %>
          <textarea id="block_<%= block[:key] %>" name="content[blocks][<%= block[:key] %>]" rows="3" class="<%= admin_input_class %>"><%= block_value(block[:key]) %></textarea>
        <% else %>
          <input id="block_<%= block[:key] %>" type="text" name="content[blocks][<%= block[:key] %>]" value="<%= block_value(block[:key]) %>" class="<%= admin_input_class %>">
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Repeating sections %>
  <% @config[:sections].each do |section| %>
    <div class="rounded-2xl border border-slate-200 bg-white p-6 space-y-4">
      <h3 class="text-sm font-semibold text-slate-900"><%= section[:label] %></h3>
      <p class="text-xs text-slate-500">Clear all fields in a row (or tick Remove) to delete it. Fill the empty row to add a new entry.</p>
      <% items_for_form(section[:key]).each_with_index do |item, i| %>
        <div class="grid gap-3 rounded-xl border border-slate-200 p-4 sm:grid-cols-2">
          <input type="hidden" name="content[sections][<%= section[:key] %>][<%= i %>][id]" value="<%= item.id %>">
          <% section[:fields].each do |field| %>
            <% value = field.meta ? item.meta[field.name] : item.public_send(field.name) %>
            <div>
              <label class="text-xs font-medium text-slate-600"><%= field.label %></label>
              <input type="text" name="content[sections][<%= section[:key] %>][<%= i %>][<%= field.name %>]" value="<%= value %>" class="<%= admin_input_class %>">
            </div>
          <% end %>
          <% if item.persisted? %>
            <label class="flex items-center gap-2 text-xs font-medium text-slate-500 sm:col-span-2">
              <input type="checkbox" name="content[sections][<%= section[:key] %>][<%= i %>][_destroy]" value="1" class="rounded border-slate-300"> Remove this entry
            </label>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center gap-3">
    <%= submit_tag "Save content", class: "btn btn-brand cursor-pointer" %>
    <%= link_to "Cancel", admin_content_index_path, class: "text-sm text-slate-500" %>
  </div>
<% end %>
