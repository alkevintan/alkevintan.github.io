<% content_for :title, "Leads" %>

<div class="mb-5 flex flex-wrap gap-2">
  <%= link_to "All", admin_leads_path,
        class: "rounded-full px-3.5 py-1.5 text-sm font-medium #{@status.nil? ? 'bg-brand-600 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50'}" %>
  <% @statuses.each do |status| %>
    <%= link_to Lead::STATUS_LABELS[status], admin_leads_path(status: status),
          class: "rounded-full px-3.5 py-1.5 text-sm font-medium #{@status == status ? 'bg-brand-600 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50'}" %>
  <% end %>
</div>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
  <% if @leads.any? %>
    <table class="w-full text-sm">
      <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wider text-slate-400">
        <tr>
          <th class="px-5 py-3 font-medium">Name</th>
          <th class="px-5 py-3 font-medium">Contact</th>
          <th class="px-5 py-3 font-medium">Project</th>
          <th class="px-5 py-3 font-medium">Status</th>
          <th class="px-5 py-3 font-medium">Received</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @leads.each do |lead| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3"><%= link_to lead.display_name, admin_lead_path(lead), class: "font-medium text-brand-600" %></td>
            <td class="px-5 py-3 text-slate-600"><%= lead.email %><% if lead.phone.present? %><br><span class="text-slate-400"><%= lead.phone %></span><% end %></td>
            <td class="px-5 py-3 text-slate-600"><%= lead.project_type.presence || "—" %></td>
            <td class="px-5 py-3"><%= render "admin/leads/status_badge", lead: lead %></td>
            <td class="px-5 py-3 text-slate-500"><%= lead.created_at.strftime("%b %-d, %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-5 py-12 text-center text-slate-500">No leads<%= " with this status" if @status %> yet.</p>
  <% end %>
</div>
