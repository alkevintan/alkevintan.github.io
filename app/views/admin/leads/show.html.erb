<% content_for :title, @lead.display_name %>

<%= link_to "&larr; Back to leads".html_safe, admin_leads_path, class: "text-sm font-medium text-brand-600" %>

<div class="mt-4 grid gap-6 lg:grid-cols-3">
  <%# Details %>
  <div class="lg:col-span-2 space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <div class="flex items-start justify-between">
        <div>
          <h2 class="text-xl font-semibold text-slate-900"><%= @lead.name %></h2>
          <p class="mt-1 text-sm text-slate-500">Received <%= @lead.created_at.strftime("%B %-d, %Y at %-I:%M %p") %></p>
        </div>
        <%= render "admin/leads/status_badge", lead: @lead %>
      </div>

      <dl class="mt-6 grid gap-4 sm:grid-cols-2 text-sm">
        <div>
          <dt class="text-slate-500">Email</dt>
          <dd><%= link_to @lead.email, "mailto:#{@lead.email}", class: "font-medium text-brand-600" %></dd>
        </div>
        <% { "Phone" => @lead.phone, "Company" => @lead.company, "Project type" => @lead.project_type,
             "Budget" => @lead.budget_range, "Timeline" => @lead.timeline, "Source page" => @lead.source_page }.each do |label, value| %>
          <% if value.present? %>
            <div><dt class="text-slate-500"><%= label %></dt><dd class="font-medium text-slate-900 break-words"><%= value %></dd></div>
          <% end %>
        <% end %>
      </dl>

      <div class="mt-6">
        <h3 class="text-sm text-slate-500">Message</h3>
        <p class="mt-1 whitespace-pre-wrap text-slate-800"><%= @lead.message %></p>
      </div>

      <% if @lead.utm_source.present? || @lead.utm_campaign.present? %>
        <p class="mt-6 text-xs text-slate-400">
          UTM: <%= [@lead.utm_source, @lead.utm_medium, @lead.utm_campaign].compact_blank.join(" / ") %>
        </p>
      <% end %>
    </div>
  </div>

  <%# Pipeline + notes %>
  <div class="space-y-6">
    <%= form_with model: [:admin, @lead], method: :patch, class: "rounded-2xl border border-slate-200 bg-white p-6 space-y-4" do |f| %>
      <div>
        <%= f.label :status, "Status", class: "block text-sm font-medium text-slate-700" %>
        <%= f.select :status, Lead::STATUS_LABELS.map { |k, v| [v, k] }, {},
              class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= f.label :admin_notes, "Internal notes", class: "block text-sm font-medium text-slate-700" %>
        <%= f.text_area :admin_notes, rows: 6,
              class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <%= f.submit "Save", class: "btn btn-brand w-full cursor-pointer" %>
    <% end %>

    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <%= link_to "Reply by email", "mailto:#{@lead.email}", class: "btn btn-outline w-full" %>
      <%= button_to "Delete lead", admin_lead_path(@lead), method: :delete,
            form: { data: { turbo_confirm: "Delete this lead permanently?" } },
            class: "mt-3 w-full rounded-xl px-6 py-3 text-sm font-semibold text-red-600 hover:bg-red-50" %>
    </div>
  </div>
</div>
