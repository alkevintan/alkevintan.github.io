<%= form_with model: [:admin, testimonial], class: "max-w-2xl space-y-6" do |f| %>
  <% if testimonial.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <ul class="list-disc pl-5"><% testimonial.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 space-y-5">
    <div>
      <%= f.label :quote, "Testimonial quote", class: admin_label_class %>
      <%= f.text_area :quote, rows: 4, class: admin_input_class %>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= f.label :author_name, class: admin_label_class %>
        <%= f.text_field :author_name, class: admin_input_class %>
      </div>
      <div>
        <%= f.label :rating, "Rating (1–5)", class: admin_label_class %>
        <%= f.select :rating, (1..5).to_a, {}, class: admin_input_class %>
      </div>
      <div>
        <%= f.label :role, "Role / title", class: admin_label_class %>
        <%= f.text_field :role, class: admin_input_class %>
      </div>
      <div>
        <%= f.label :company, class: admin_label_class %>
        <%= f.text_field :company, class: admin_input_class %>
      </div>
      <div>
        <%= f.label :position, "Sort position", class: admin_label_class %>
        <%= f.number_field :position, class: admin_input_class %>
      </div>
    </div>
    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
      <%= f.check_box :featured, class: "rounded border-slate-300" %> Featured on home page
    </label>
    <div>
      <%= f.label :avatar, "Avatar (optional)", class: admin_label_class %>
      <% if testimonial.avatar.attached? %>
        <%= image_tag testimonial.avatar.variant(resize_to_fill: [64, 64]), class: "my-2 h-16 w-16 rounded-full object-cover" %>
      <% end %>
      <%= f.file_field :avatar, accept: "image/*", class: "block w-full text-sm text-slate-600" %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit(testimonial.persisted? ? "Update" : "Create", class: "btn btn-brand cursor-pointer") %>
    <%= link_to "Cancel", admin_testimonials_path, class: "text-sm text-slate-500" %>
    <% if testimonial.persisted? %>
      <%= button_to "Delete", admin_testimonial_path(testimonial), method: :delete,
            form: { data: { turbo_confirm: "Delete this testimonial?" }, class: "ml-auto" },
            class: "text-sm font-medium text-red-600 hover:underline" %>
    <% end %>
  </div>
<% end %>
