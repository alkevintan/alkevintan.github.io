<% content_for :title, "Testimonials" %>

<div class="mb-5 flex justify-end">
  <%= link_to "+ New testimonial", new_admin_testimonial_path, class: "btn btn-brand" %>
</div>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
  <% if @testimonials.any? %>
    <table class="w-full text-sm">
      <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wider text-slate-400">
        <tr>
          <th class="px-5 py-3 font-medium">Author</th>
          <th class="px-5 py-3 font-medium">Company</th>
          <th class="px-5 py-3 font-medium">Rating</th>
          <th class="px-5 py-3 font-medium">Featured</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @testimonials.each do |t| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3"><%= link_to t.author_name, edit_admin_testimonial_path(t), class: "font-medium text-brand-600" %></td>
            <td class="px-5 py-3 text-slate-600"><%= [t.role, t.company].compact_blank.join(", ").presence || "—" %></td>
            <td class="px-5 py-3 text-amber-500"><%= "★" * (t.rating || 0) %></td>
            <td class="px-5 py-3 text-slate-600"><%= t.featured? ? "★" : "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-5 py-12 text-center text-slate-500">No testimonials yet. <%= link_to "Add one", new_admin_testimonial_path, class: "font-medium text-brand-600" %>.</p>
  <% end %>
</div>
