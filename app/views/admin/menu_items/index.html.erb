<% content_for :title, "Menus" %>

<div class="mb-5 flex justify-end">
  <%= link_to "+ New link", new_admin_menu_item_path, class: "btn btn-brand" %>
</div>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
  <% if @menu_items.any? %>
    <table class="w-full text-sm">
      <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wider text-slate-400">
        <tr>
          <th class="px-5 py-3 font-medium">Label</th>
          <th class="px-5 py-3 font-medium">URL</th>
          <th class="px-5 py-3 font-medium">Menu</th>
          <th class="px-5 py-3 font-medium">Order</th>
          <th class="px-5 py-3 font-medium">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @menu_items.each do |item| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3"><%= link_to item.label, edit_admin_menu_item_path(item), class: "font-medium text-brand-600" %></td>
            <td class="px-5 py-3 text-slate-500"><%= item.url %></td>
            <td class="px-5 py-3 text-slate-600"><%= item.menu_label %></td>
            <td class="px-5 py-3 text-slate-500"><%= item.position %></td>
            <td class="px-5 py-3">
              <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium <%= item.published? ? 'bg-green-100 text-green-800' : 'bg-slate-200 text-slate-600' %>"><%= item.published? ? "Visible" : "Hidden" %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-5 py-12 text-center text-slate-500">No menu links yet. <%= link_to "Add your first link", new_admin_menu_item_path, class: "font-medium text-brand-600" %>.</p>
  <% end %>
</div>
