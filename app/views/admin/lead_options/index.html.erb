<% content_for :title, "Form Options" %>

<div class="mb-5 flex items-center justify-between">
  <p class="text-sm text-slate-500">Dropdown choices on the contact form.</p>
  <%= link_to "+ New option", new_admin_lead_option_path, class: "btn btn-brand" %>
</div>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
  <% if @lead_options.any? %>
    <table class="w-full text-sm">
      <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wider text-slate-400">
        <tr>
          <th class="px-5 py-3 font-medium">Label</th>
          <th class="px-5 py-3 font-medium">Field</th>
          <th class="px-5 py-3 font-medium">Order</th>
          <th class="px-5 py-3 font-medium">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @lead_options.each do |option| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3"><%= link_to option.label, edit_admin_lead_option_path(option), class: "font-medium text-brand-600" %></td>
            <td class="px-5 py-3 text-slate-600"><%= option.field_label %></td>
            <td class="px-5 py-3 text-slate-500"><%= option.position %></td>
            <td class="px-5 py-3">
              <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium <%= option.published? ? 'bg-green-100 text-green-800' : 'bg-slate-200 text-slate-600' %>"><%= option.published? ? "Visible" : "Hidden" %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-5 py-12 text-center text-slate-500">No options yet. <%= link_to "Add your first option", new_admin_lead_option_path, class: "font-medium text-brand-600" %>.</p>
  <% end %>
</div>
