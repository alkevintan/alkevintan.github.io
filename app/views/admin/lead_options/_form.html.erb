<%= form_with model: [:admin, lead_option], class: "space-y-6" do |f| %>
  <% if lead_option.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
      <ul class="list-disc pl-5"><% lead_option.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 space-y-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= f.label :label, class: admin_label_class %>
        <%= f.text_field :label, class: admin_input_class %>
      </div>
      <div>
        <%= f.label :field, "Dropdown", class: admin_label_class %>
        <%= f.select :field, LeadOption::FIELD_LABELS.map { |k, v| [v, k] }, {}, class: admin_input_class %>
      </div>
      <div>
        <%= f.label :position, "Order (lower shows first)", class: admin_label_class %>
        <%= f.number_field :position, class: admin_input_class %>
      </div>
    </div>
    <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
      <%= f.check_box :published, class: "rounded border-slate-300" %> Visible
    </label>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit(lead_option.persisted? ? "Update option" : "Create option", class: "btn btn-brand cursor-pointer") %>
    <%= link_to "Cancel", admin_lead_options_path, class: "text-sm text-slate-500" %>
    <% if lead_option.persisted? %>
      <%= button_to "Delete", admin_lead_option_path(lead_option), method: :delete,
            form: { data: { turbo_confirm: "Delete this option?" }, class: "ml-auto" },
            class: "text-sm font-medium text-red-600 hover:underline" %>
    <% end %>
  </div>
<% end %>
