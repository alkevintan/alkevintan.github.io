<% content_for :title, "FAQs" %>

<div class="mb-5 flex justify-end">
  <%= link_to "+ New FAQ", new_admin_faq_path, class: "btn btn-brand" %>
</div>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
  <% if @faqs.any? %>
    <table class="w-full text-sm">
      <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wider text-slate-400">
        <tr>
          <th class="px-5 py-3 font-medium">Question</th>
          <th class="px-5 py-3 font-medium">Page</th>
          <th class="px-5 py-3 font-medium">Order</th>
          <th class="px-5 py-3 font-medium">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @faqs.each do |faq| %>
          <tr class="hover:bg-slate-50">
            <td class="px-5 py-3"><%= link_to faq.question, edit_admin_faq_path(faq), class: "font-medium text-brand-600" %></td>
            <td class="px-5 py-3 text-slate-600"><%= faq.page_label %></td>
            <td class="px-5 py-3 text-slate-500"><%= faq.position %></td>
            <td class="px-5 py-3">
              <span class="inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium <%= faq.published? ? 'bg-green-100 text-green-800' : 'bg-slate-200 text-slate-600' %>"><%= faq.published? ? "Published" : "Hidden" %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-5 py-12 text-center text-slate-500">No FAQs yet. <%= link_to "Add your first FAQ", new_admin_faq_path, class: "font-medium text-brand-600" %>.</p>
  <% end %>
</div>
