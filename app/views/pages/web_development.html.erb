<% set_meta title: "Web Development Philippines", description: content_text("web_development", "meta_description") %>

<%= render "shared/page_header", eyebrow: content_block("web_development", "header_eyebrow"),
      title: content_block("web_development", "header_title"),
      subtitle: content_block("web_development", "header_subtitle") %>

<section class="site-container py-16">
  <div class="prose-content max-w-3xl">
    <%= content_block("web_development", "intro") %>
  </div>

  <%# What we build %>
  <div class="mt-14">
    <h2 class="text-2xl"><%= content_block("web_development", "what_heading") %></h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% content_items("web_development", "what_we_build").each do |item| %>
        <div class="card">
          <h3 class="font-semibold text-slate-900"><%= raw item.title %></h3>
          <p class="mt-2 text-sm text-slate-600"><%= raw item.body %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# Process %>
<section class="bg-slate-50 py-16">
  <div class="site-container">
    <h2 class="text-2xl"><%= content_block("web_development", "process_heading") %></h2>
    <ol class="mt-8 grid gap-8 md:grid-cols-4">
      <% content_items("web_development", "process").each_with_index do |step, i| %>
        <li>
          <span class="font-display text-2xl font-bold text-brand-500"><%= raw step.meta["number"].presence || format("%02d", i + 1) %></span>
          <h3 class="mt-2 font-semibold text-slate-900"><%= raw step.title %></h3>
          <p class="mt-1 text-sm text-slate-600"><%= raw step.body %></p>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<%# Tech %>
<section class="site-container py-16">
  <div class="max-w-3xl">
    <h2 class="text-2xl"><%= content_block("web_development", "tech_heading") %></h2>
    <p class="mt-3 text-slate-600"><%= content_block("web_development", "tech_body") %></p>
    <div class="mt-6 flex flex-wrap gap-2">
      <% content_items("web_development", "tech_tags").each do |tag| %>
        <span class="rounded-full bg-slate-100 px-4 py-1.5 text-sm font-medium text-slate-700"><%= raw tag.title %></span>
      <% end %>
    </div>
  </div>
</section>

<%= render "shared/faq", faqs: faqs_for("web_development") %>

<%= render "shared/cta", title: content_block("web_development", "cta_title") %>
