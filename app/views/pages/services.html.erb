<% set_meta title: "Services",
     description: "Web development, web apps, mobile apps and SEO for Philippine businesses. See how AktiveSolutions can help you build and grow — from Bicol, nationwide." %>

<%= render "shared/page_header", eyebrow: "What we do",
      title: "Services",
      subtitle: "End-to-end design, development and growth for web and mobile — built for the Philippine market." %>

<section class="site-container py-16">
  <div class="grid gap-8 md:grid-cols-2">
    <%= link_to web_development_path, class: "card group flex flex-col" do %>
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25"/></svg>
      </div>
      <h2 class="mt-5 text-xl font-semibold text-slate-900 group-hover:text-brand-600">Web Development</h2>
      <p class="mt-2 flex-1 text-slate-600">Marketing sites, e-commerce, dashboards and custom web apps — fast, secure and SEO-ready.</p>
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">Learn more <span aria-hidden="true">&rarr;</span></span>
    <% end %>

    <%= link_to mobile_development_path, class: "card group flex flex-col" do %>
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>
      </div>
      <h2 class="mt-5 text-xl font-semibold text-slate-900 group-hover:text-brand-600">Mobile App Development</h2>
      <p class="mt-2 flex-1 text-slate-600">Native and cross-platform iOS &amp; Android apps, from idea to the App Store and Google Play.</p>
      <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">Learn more <span aria-hidden="true">&rarr;</span></span>
    <% end %>
  </div>

  <%# Also offer %>
  <div class="mt-14">
    <h2 class="text-2xl">We also help with</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        ["SEO & Growth", "Rank on Google and turn traffic into leads."],
        ["E-commerce", "Sell online with secure payments and shipping."],
        ["UI/UX Design", "Clean, modern, mobile-first interfaces."],
        ["Maintenance & Support", "Keep your site or app fast, secure and up to date."]
      ].each do |title, body| %>
        <div>
          <h3 class="font-semibold text-slate-900"><%= title %></h3>
          <p class="mt-1.5 text-sm text-slate-600"><%= body %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%= render "shared/faq", faqs: faqs_for("services") %>

<%= render "shared/cta" %>
