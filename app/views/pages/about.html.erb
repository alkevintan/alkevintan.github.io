<% set_meta title: "About Us", description: content_text("about", "meta_description") %>

<%= render "shared/page_header", eyebrow: content_block("about", "header_eyebrow"),
      title: content_block("about", "header_title"),
      subtitle: content_block("about", "header_subtitle") %>

<section class="site-container py-16">
  <div class="prose-content max-w-3xl">
    <h2><%= content_block("about", "story_heading") %></h2>
    <%= content_block("about", "story_body") %>
  </div>

  <div class="mt-14 grid gap-8 md:grid-cols-3">
    <% content_items("about", "values").each do |value| %>
      <div class="card">
        <h3 class="text-lg font-semibold text-slate-900"><%= raw value.title %></h3>
        <p class="mt-2 text-sm text-slate-600"><%= raw value.body %></p>
      </div>
    <% end %>
  </div>
</section>

<section class="bg-slate-950 py-16 text-white">
  <div class="site-container grid gap-8 text-center sm:grid-cols-3">
    <% content_items("about", "stats").each do |stat| %>
      <div>
        <p class="font-display text-2xl font-bold text-white"><%= raw stat.title %></p>
        <p class="mt-1 text-sm text-slate-400"><%= raw stat.body %></p>
      </div>
    <% end %>
  </div>
</section>

<%= render "shared/cta" %>
