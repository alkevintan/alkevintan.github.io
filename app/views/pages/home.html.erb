<% set_meta title: nil, description: content_text("home", "meta_description") %>

<%# ===== Hero ===== %>
<section class="relative overflow-hidden bg-slate-950 text-white">
  <div class="pointer-events-none absolute inset-0 opacity-60"
       style="background:radial-gradient(60rem 30rem at 70% -10%, rgba(5,150,105,.35), transparent 60%),radial-gradient(40rem 25rem at 10% 20%, rgba(245,158,11,.12), transparent 60%)"></div>
  <div class="site-container relative py-20 sm:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow text-brand-300"><%= content_block("home", "hero_eyebrow") %></p>
      <h1 class="mt-4 text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">
        <%= content_block("home", "hero_heading") %>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-300">
        <%= content_block("home", "hero_body") %>
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <%= link_to content_block("home", "hero_cta_primary"), contact_path, class: "btn btn-primary" %>
        <%= link_to content_block("home", "hero_cta_secondary"), services_path, class: "btn btn-ghost-light" %>
      </div>
      <dl class="mt-14 grid max-w-lg grid-cols-3 gap-6">
        <% content_items("home", "hero_stats").each do |stat| %>
          <div>
            <dt class="text-2xl font-bold text-white"><%= raw stat.title %></dt>
            <dd class="text-sm text-slate-400"><%= raw stat.body %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</section>

<%# ===== Services preview ===== %>
<section class="site-container py-20">
  <div class="mx-auto max-w-2xl text-center">
    <p class="eyebrow justify-center"><%= content_block("home", "services_eyebrow") %></p>
    <h2 class="mt-3 text-3xl sm:text-4xl"><%= content_block("home", "services_heading") %></h2>
    <p class="mt-4 text-lg text-slate-600">
      <%= content_block("home", "services_body") %>
    </p>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <% content_items("home", "services_cards").each do |card| %>
      <%= link_to(card.meta["path"].presence || "#", class: "card group block") do %>
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="mt-5 text-lg font-semibold text-slate-900"><%= raw card.title %></h3>
        <p class="mt-2 text-sm text-slate-600"><%= raw card.body %></p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 group-hover:gap-2 transition-all">
          Learn more <span aria-hidden="true">&rarr;</span>
        </span>
      <% end %>
    <% end %>
  </div>
</section>

<%# ===== Why us ===== %>
<section class="bg-slate-50 py-20">
  <div class="site-container grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow"><%= content_block("home", "whyus_eyebrow") %></p>
      <h2 class="mt-3 text-3xl sm:text-4xl"><%= content_block("home", "whyus_heading") %></h2>
      <p class="mt-4 text-lg text-slate-600">
        <%= content_block("home", "whyus_body") %>
      </p>
      <ul class="mt-8 space-y-4">
        <% content_items("home", "whyus_points").each do |point| %>
          <li class="flex gap-3">
            <svg class="mt-0.5 h-6 w-6 flex-none text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span><strong class="font-semibold text-slate-900"><%= raw point.title %>.</strong> <span class="text-slate-600"><%= raw point.body %></span></span>
          </li>
        <% end %>
      </ul>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <h3 class="text-xl"><%= content_block("home", "whyus_card_heading") %></h3>
      <p class="mt-2 text-slate-600"><%= content_block("home", "whyus_card_body") %></p>
      <%= link_to content_block("home", "whyus_card_cta"), contact_path, class: "btn btn-brand mt-6 w-full" %>
      <p class="mt-4 text-center text-sm text-slate-500">or email <%= link_to SITE[:email], "mailto:#{SITE[:email]}", class: "font-medium text-brand-600" %></p>
    </div>
  </div>
</section>

<%# ===== Featured work ===== %>
<% if @featured_case_studies.any? %>
  <section class="site-container py-20">
    <div class="flex items-end justify-between">
      <div>
        <p class="eyebrow">Our work</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Recent projects</h2>
      </div>
      <%= link_to "View all", portfolio_path, class: "hidden text-sm font-semibold text-brand-600 sm:block" %>
    </div>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <% @featured_case_studies.each do |cs| %>
        <%= link_to portfolio_item_path(cs), class: "group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md" do %>
          <div class="aspect-[16/9] overflow-hidden bg-slate-100">
            <% if cs.cover_image.attached? %>
              <%= image_tag cs.cover_image.variant(resize_to_fill: [900, 506]), alt: cs.title, loading: "lazy", class: "h-full w-full object-cover transition group-hover:scale-105" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-slate-800 to-slate-950 p-6 text-center text-white/80"><span class="font-display text-lg font-bold"><%= cs.title %></span></div>
            <% end %>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-center gap-2 text-xs text-slate-500">
              <% if cs.client.present? %><span><%= cs.client %></span><% end %>
              <% if cs.industry.present? %><span>·</span><span><%= cs.industry %></span><% end %>
            </div>
            <h3 class="mt-2 text-lg font-semibold text-slate-900 group-hover:text-brand-600"><%= cs.title %></h3>
            <p class="mt-2 text-sm text-slate-600"><%= cs.summary %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<%# ===== Testimonials ===== %>
<% if @testimonials.any? %>
  <section class="bg-slate-950 py-20 text-white">
    <div class="site-container">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow justify-center text-brand-300">Testimonials</p>
        <h2 class="mt-3 text-3xl text-white sm:text-4xl">What our clients say</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <% @testimonials.each do |t| %>
          <figure class="flex h-full flex-col rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
            <div class="text-accent-400" aria-hidden="true"><%= "★" * (t.rating || 5) %></div>
            <blockquote class="mt-3 flex-1 text-slate-200">"<%= t.quote %>"</blockquote>
            <figcaption class="mt-5 flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 text-sm font-semibold text-white"><%= t.initials %></span>
              <span>
                <span class="block text-sm font-semibold text-white"><%= t.author_name %></span>
                <span class="block text-xs text-slate-400"><%= [t.role, t.company].compact_blank.join(", ") %></span>
              </span>
            </figcaption>
          </figure>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# ===== Latest from the blog ===== %>
<% if @recent_posts.any? %>
  <section class="site-container py-20">
    <div class="flex items-end justify-between">
      <div>
        <p class="eyebrow">Insights</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">From the blog</h2>
      </div>
      <%= link_to "All articles", blog_path, class: "hidden text-sm font-semibold text-brand-600 sm:block" %>
    </div>
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      <%= render partial: "posts/post_card", collection: @recent_posts, as: :post %>
    </div>
  </section>
<% end %>

<%= render "shared/cta" %>
